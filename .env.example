# ════════════════════════════════════════════════
#  Umuhle — Environment Variables
#  Copy to .env.local (never commit .env.local)
# ════════════════════════════════════════════════

# ── App URL (no trailing slash) ───────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: NEXT_PUBLIC_APP_URL=https://umuhle.co.za

# ── Supabase ──────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # SERVER-SIDE ONLY. Never expose to browser.

# ── PayFast ───────────────────────────────────────
# Get these from: https://www.payfast.co.za → My Account → Settings → API
# Sandbox: https://sandbox.payfast.co.za (merchant_id: 10000100, merchant_key: 46f0cd694581a)
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=                  # Only set if you enabled a passphrase in PayFast
PAYFAST_ENV=sandbox                  # Change to "live" for production

# ── WhatsApp (Meta Cloud API) ─────────────────────
# Get these from: https://developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token

# ── Shipping: The Courier Guy (via Ship Logic) ────
# Get SHIPLOGIC_API_KEY from: https://www.shiplogic.com (free signup).
# Unlike PayFast above, Ship Logic has no shared/public sandbox key —
# every account, including the free sandbox tier, is tied to a real
# signup. Leave SHIPLOGIC_API_KEY blank to run lib/shiplogic.ts in its
# built-in mock mode (deterministic fake quotes/waybills, clearly labelled
# "(sandbox — mock)" everywhere they show up) so the courier quote → book
# → track flow is still fully testable with nothing set here.
SHIPLOGIC_API_KEY=
SHIPLOGIC_API_BASE=https://api.shiplogic.com/v2

